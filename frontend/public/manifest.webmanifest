{
  "id": "/",
  "name": "RadioCrate",
  "short_name": "RadioCrate",
  "description": "Manage and play your audio collection.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
