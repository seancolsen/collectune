# Generated by Cargo
# will have compiled files and executables
/target/
backend/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock is checked in for the backend executable

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by `bun run build` (Vite) — the Solid frontend's output, embedded
# into the production binary at build time. The .gitkeep placeholder keeps the
# directory present so `rust-embed` doesn't fail before the first Vite build on
# a fresh checkout.
/frontend/dist/*
!/frontend/dist/.gitkeep

# New SolidJS frontend transients.
/frontend/node_modules/
# The Querydown JS binding (querydown-js) is a wasm-pack build artifact,
# regenerated by `cargo xtask build-release` (and manually in dev via
# `wasm-pack build bindings/js --target web` on a pinned Querydown checkout).
/frontend/vendor/querydown-js/
# The track-lineage binding is likewise a wasm-pack artifact, regenerated from
# the in-repo `track-lineage/` crate via `track-lineage/build.sh`.
/frontend/vendor/track-lineage/
/frontend/dev-dist/
/frontend/test-results/
/frontend/playwright-report/
# Playwright's transient screenshot artifact (baselines under __screenshots__/
# are committed).
*-actual.png

# Python bytecode cache.
__pycache__/
*.pyc

# The database the backend creates in whichever collection root it is pointed at,
# including the sample collections under sample-data/.
radiocrate.db
